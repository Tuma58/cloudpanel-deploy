# Пример конфигурации развёртывания CloudPanel.
# Скопируйте в deploy.env и заполните значения.
# НЕ храните пароли, токены и приватные ключи в этом файле.

# Имя проекта (используется в журналах)
PROJECT_NAME="cloudpanel-deploy"

# Режим: diagnose | prepare | install | verify | postinstall
DEPLOY_MODE="diagnose"

# Поддерживаемые версии Debian согласно официальным Requirements CloudPanel
# https://www.cloudpanel.io/docs/v2/requirements/
SUPPORTED_DEBIAN_VERSIONS="12 13"

# Минимальные ресурсы (официальные требования CloudPanel)
MIN_RAM_MB=2048
MIN_DISK_GB=10
MIN_CPU_CORES=1

# Архитектуры: x86_64 / amd64 и aarch64 / arm64
SUPPORTED_ARCHITECTURES="x86_64 amd64 aarch64 arm64"

# Домен будущего WordPress-сайта (необязательно на этапе установки панели)
SITE_DOMAIN=""

# Публичный IPv4 сервера (если известен; иначе будет определён автоматически)
EXPECTED_PUBLIC_IPV4=""

# Ожидаемый hostname / FQDN (необязательно; смена hostname не выполняется автоматически)
EXPECTED_HOSTNAME=""

# Движок БД для официального установщика CloudPanel
# Debian 12: MYSQL_8.4 | MYSQL_8.0 | MARIADB_10.11 | MARIADB_11.4 | MARIADB_11.8 | MARIADB_12.3
# Debian 13: MYSQL_8.4 | MYSQL_8.0 | MARIADB_11.8 | MARIADB_12.3
# Рекомендация для WordPress: MARIADB_11.8
DB_ENGINE="MARIADB_11.8"

# Официальный URL установщика CloudPanel CE v2
INSTALLER_URL="https://installer.cloudpanel.io/ce/v2/install.sh"

# SHA-256 установщика из официальной документации CloudPanel.
# Перед установкой сверьте значение с актуальной страницей:
# https://www.cloudpanel.io/docs/v2/getting-started/other/
# Не выдумывайте контрольную сумму. Если документация изменилась — обновите значение.
INSTALLER_SHA256="8146dbe0a488e7088b04071b0c34d59aa0ab1fe9dcec382d395fd155c9e6c476"

# Каталоги проекта (обычно не нужно менять)
LOG_DIR=""
STATE_DIR=""
ARTIFACT_DIR=""

# Сетевые проверки
DNS_TEST_HOST="deb.debian.org"
# Корень installer.cloudpanel.io/ часто отдаёт HTTP 403 — проверяем сам install.sh
HTTPS_TEST_URL="https://installer.cloudpanel.io/ce/v2/install.sh"
APT_MIRROR_CHECK="1"
CHECK_IPV6="1"
# Swap при RAM < MIN_RAM_MB (съедает место на диске — учитывайте запас)
ENSURE_SWAP="YES"
SWAP_SIZE_MB="2048"
MIN_FREE_DISK_AFTER_SWAP_GB="5"

# Порты, ожидаемые после установки / для firewall
SSH_PORT="22"
HTTP_PORT="80"
HTTPS_PORT="443"
CLOUDPANEL_PORT="8443"

# IP администратора для рекомендации ограничения доступа к 8443 (пусто = не ограничивать автоматически)
ADMIN_SOURCE_IP=""

# Подтверждения разрушительных / необратимых действий
# Установка CloudPanel возможна только при CONFIRM_INSTALL=YES
CONFIRM_INSTALL="NO"

# Применение обновлений безопасности в 10-prepare-system.sh
# YES — выполнить apt upgrade; NO — только отчёт
APPLY_SECURITY_UPDATES="NO"

# Разрешить перезагрузку после обновлений (требует явного YES)
CONFIRM_REBOOT="NO"

# Разрешить изменение hostname (отдельная документированная процедура; по умолчанию запрещено)
CONFIRM_HOSTNAME_CHANGE="NO"
NEW_HOSTNAME=""

# Строгость preflight: block | warn
# block — конфликты останавливают установку; warn — только предупреждения (не рекомендуется)
CONFLICT_POLICY="block"

# Таймауты сетевых проверок (секунды)
NETWORK_TIMEOUT=10
CURL_CONNECT_TIMEOUT=8
